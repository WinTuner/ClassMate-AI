NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here-never-expose-to-client
# ThaiLLM (server only, OpenAI-compatible) — https://thaillm.or.th → API Key
THAILLM_API_KEY=paste-thaillm-key-here-server-only
THAILLM_BASE_URL=https://api.thaillm.or.th/v1
THAILLM_MODEL=Typhoon-S-ThaiLLM-8B-Instruct
# Embeddings (pgvector 768-dim) — ยังใช้ Gemini ไปก่อนจนกว่า ThaiLLM จะมี embeddings
GEMINI_API_KEY=paste-gemini-key-here-server-only
# Optional tuning
SIMILARITY_THRESHOLD=0.35
TOP_K=5
MAX_PDF_MB=20
